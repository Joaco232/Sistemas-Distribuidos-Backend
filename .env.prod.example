# Plantilla del .env para el servidor de produccion.
# En la instancia:  cp .env.prod.example .env  y completar los valores vacios.
# El .env real NO se commitea (ver .gitignore).
#
# Generar los secretos:
#   JWT_SECRET         ->  openssl rand -hex 32
#   POSTGRES_PASSWORD  ->  openssl rand -base64 24

# Ruta al Dockerfile del frontend, relativa a esta carpeta.
# Los dos repos tienen que quedar como carpetas hermanas.
FRONTEND_CONTEXT=../Sistemas-Distribuidos-Frontend/movienow-frontend

POSTGRES_DB=movienow
POSTGRES_USER=movienow
# OJO: si cambias esta password despues del primer arranque, no aplica sola.
# El volumen postgres_data ya quedo inicializado con la anterior.
POSTGRES_PASSWORD=

# Obligatorio. Minimo 32 bytes: el backend firma los JWT con HMAC-SHA384.
JWT_SECRET=

# Opcionales -----------------------------------------------------------------

# Si no se definen, se usan los defaults de TMDB del docker-compose.yml.
# MOVIENOW_API_KEY=
# MOVIENOW_API_TOKEN=

# Solo sirve si volves a levantar RabbitMQ (ver RABBITMQ_ENABLED).
# Sin esto los mails de bienvenida no se envian, pero la app funciona igual.
# SENDGRID_API_KEY=

# Poner en true unicamente si agregas de nuevo el servicio rabbitmq al compose.
# RABBITMQ_ENABLED=false
